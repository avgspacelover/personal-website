DATABASE_URL=
SITE_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console > OAuth client (Web). Redirect URI: <SITE_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google accounts allowed into /admin
ADMIN_EMAILS=you@gmail.com
STORAGE_DRIVER=local
MEDIA_DIR=.data/media
# MEDIA_PUBLIC_BASE=   (set to a CDN/bucket URL after moving to object storage)
# Optional: enables model-written resume bullets (otherwise offline ranking is used)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Security (see DEPLOY.md)
# MIGRATE_DATABASE_URL=   schema-owner role used only by db:migrate/db:seed (keep out of the running service)
# SESSIONS_VALID_AFTER=   ISO date: sessions issued before it stop working
# CSP_REPORT_ONLY=1       log CSP violations instead of blocking (debugging)
